# PostgreSQL connection string (Neon, or any Postgres instance)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with: npx auth secret"
NEXTAUTH_URL="http://localhost:3000"

# App
PORT=3000
NODE_ENV="development"

# Email (Resend) — optional. Without it, password-reset links and invitation emails
# are logged to the server console instead of being sent.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="PixelForge <onboarding@resend.dev>"
