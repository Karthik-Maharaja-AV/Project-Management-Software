# PostgreSQL connection string (Neon, or any Postgres instance)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with: npx auth secret"
NEXTAUTH_URL="http://localhost:3000"

# App
PORT=3000
NODE_ENV="development"

# Email (SMTP) — optional. Without it, password-reset links and invitation emails
# are logged to the server console instead of being sent.
# For Gmail: enable 2-Step Verification on the account, then generate an App Password
# (Google Account -> Security -> 2-Step Verification -> App Passwords) and use that as
# SMTP_PASS below — not the regular account password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="you@gmail.com"
SMTP_PASS="16-character app password"
SMTP_FROM="PixelForge <you@gmail.com>"
